{
  "name": "sod-source-only-qa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:data && npm run validate:data && tsc -b && vite build",
    "build:data": "node scripts/build-conversation-data.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "validate:data": "node scripts/validate-data.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
